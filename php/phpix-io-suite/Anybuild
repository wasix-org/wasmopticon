load("//anybuild/tools:php.bzl", "php_build", "php_config", "php_serve")

config = php_config(
    schema = 1,
    php_version = "8.4",
    php_architecture = "32-bit",
    php_public_dir = "app",
    phpix = True,
    phpix_worker_threads = 1,
)

build = php_build(
    config,
    extra_ignore = ["Anybuild", "README.md", "*.sh", "*.tsv", "artillery.yml", "*.py"],
)

php_serve(config, build, name = "phpix-io-suite", extra_commands = {"local": "phpix"})
