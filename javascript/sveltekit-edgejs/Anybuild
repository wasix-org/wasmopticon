load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node ./build/index.js",
    },
    node_package_manager = "npm",
    node_install_requires_all_files = True,
    node_server = "node",
    node_build_command = "npm run build",
    node_version = "24",
    optimize_node_dependencies = False,
    edgejs_engine = "quickjs",
    edgejs_precompile = False,
)

build = node_build(config)

node_serve(config, build, name = "sveltekit-edgejs")
