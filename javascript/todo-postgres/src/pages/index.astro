---
import { desc } from "drizzle-orm";
import { db } from "../db";
import { todos } from "../db/schema";

const items = await db.select().from(todos).orderBy(desc(todos.createdAt));
const openCount = items.filter((todo) => !todo.completed).length;
const error = Astro.url.searchParams.get("error");
const dateTimeFormatter = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A small server-rendered Astro and Drizzle todo app" />
    <title>Todos</title>
    <style>
      :root {
        color-scheme: light dark;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        background: #f4f3ef;
        color: #20201d;
      }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; padding: 8vh 1rem; }
      main {
        width: min(100%, 42rem);
        margin: auto;
        padding: clamp(1.25rem, 5vw, 3rem);
        background: #fff;
        border: 1px solid #deddd7;
        border-radius: 1.25rem;
        box-shadow: 0 1.5rem 4rem #24231e12;
      }
      header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
      h1 { margin: 0; font-size: clamp(2rem, 8vw, 3.5rem); letter-spacing: -.07em; }
      header p, .empty { color: #737269; }
      .new-todo { display: flex; gap: .6rem; margin: 2rem 0; }
      input, button { font: inherit; }
      input {
        min-width: 0;
        flex: 1;
        padding: .85rem 1rem;
        color: inherit;
        background: #fafaf8;
        border: 1px solid #cbc9c0;
        border-radius: .7rem;
      }
      button {
        padding: .75rem 1rem;
        color: inherit;
        background: transparent;
        border: 1px solid #cbc9c0;
        border-radius: .7rem;
        cursor: pointer;
      }
      button:hover { border-color: #6b6a63; background: #f4f3ef; }
      .add { color: white; background: #2d5b46; border-color: #2d5b46; }
      .add:hover { background: #224936; border-color: #224936; }
      .error { padding: .75rem 1rem; color: #8a2525; background: #fff0f0; border-radius: .7rem; }
      ul { display: grid; gap: .6rem; padding: 0; list-style: none; }
      li {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: .8rem;
        padding: .65rem;
        border: 1px solid #e4e2dc;
        border-radius: .8rem;
      }
      li form { display: contents; }
      .toggle { width: 2.35rem; padding: .45rem; }
      .todo-copy { display: grid; gap: .15rem; min-width: 0; }
      .todo-copy > span { overflow-wrap: anywhere; }
      time { color: #737269; font-size: .8rem; }
      .done { color: #85847c; text-decoration: line-through; }
      .delete { padding: .45rem .65rem; color: #9b3838; border-color: transparent; }
      @media (prefers-color-scheme: dark) {
        :root { background: #181916; color: #e8e8e2; }
        main { background: #22231f; border-color: #373832; box-shadow: none; }
        input { background: #191a17; border-color: #4a4b44; }
        button { border-color: #4a4b44; }
        button:hover { background: #30312c; border-color: #77786f; }
        .add, .add:hover { background: #4d8b6b; border-color: #4d8b6b; color: #fff; }
        li { border-color: #373832; }
        .error { color: #ffb2b2; background: #4a2424; }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <h1>Todos</h1>
        <p>{openCount} open</p>
      </header>

      <form class="new-todo" method="post" action="/todos">
        <input type="hidden" name="action" value="create" />
        <input name="title" aria-label="New todo" placeholder="What needs doing?" maxlength="200" enterkeyhint="done" required autofocus />
        <button class="add" type="submit">Add</button>
      </form>

      {error && <p class="error" role="alert">{error}</p>}

      {items.length === 0 ? (
        <p class="empty">Nothing here yet. Enjoy the calm—or add a todo.</p>
      ) : (
        <ul>
          {items.map((todo) => (
            <li>
              <form method="post" action="/todos">
                <input type="hidden" name="action" value="toggle" />
                <input type="hidden" name="id" value={todo.id} />
                <input type="hidden" name="completed" value={String(!todo.completed)} />
                <button class="toggle" type="submit" aria-label={todo.completed ? `Mark ${todo.title} incomplete` : `Mark ${todo.title} complete`}>
                  {todo.completed ? "✓" : "○"}
                </button>
              </form>
              <span class="todo-copy">
                <span class:list={{ done: todo.completed }}>{todo.title}</span>
                <time datetime={todo.createdAt.toISOString()}>
                  Added {dateTimeFormatter.format(todo.createdAt)} UTC
                </time>
              </span>
              <form method="post" action="/todos">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={todo.id} />
                <button class="delete" type="submit" aria-label={`Delete ${todo.title}`}>Delete</button>
              </form>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
