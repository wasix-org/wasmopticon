---
const title = "Astro Node Example";
const renderedAt = new Date().toISOString();
const probe = Astro.url.searchParams.get("probe") ?? "ready";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Rendered by Astro on Node.</p>
      <output id="request-probe">{probe}</output>
      <form action="/echo" method="post">
        <label>Message <input name="message" /></label>
        <button>Echo</button>
      </form>
      <time datetime={renderedAt}>{renderedAt}</time>
    </main>
  </body>
</html>
